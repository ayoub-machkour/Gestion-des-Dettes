import { DatabaseSync } from 'node:sqlite';
import { SCHEMA_SQL, undoTriggersSql } from '../src/db/migrations.ts';
const db = new DatabaseSync(':memory:');
db.exec('PRAGMA foreign_keys = ON;'); db.exec(SCHEMA_SQL); db.exec(undoTriggersSql());
const run = (s, ...p) => db.prepare(s).run(...p);
const all = (s, ...p) => db.prepare(s).all(...p);
const action = (fn) => { db.exec('BEGIN'); run('UPDATE undo_state SET grp = grp + 1 WHERE id = 1'); const g = db.prepare('SELECT grp FROM undo_state').get().grp; run("INSERT INTO undo_groups VALUES (?, 'x', 'now')", g); fn(); db.exec('COMMIT'); };
const undo = () => { const g = db.prepare('SELECT MAX(grp) g FROM undo_groups').get().g; const steps = all('SELECT sql FROM undo_log WHERE grp = ? ORDER BY seq DESC', g);
  db.exec('BEGIN'); db.exec('PRAGMA defer_foreign_keys = ON'); run('UPDATE undo_state SET active = 0'); for (const s of steps) db.exec(s.sql);
  run('DELETE FROM undo_log WHERE grp = ?', g); run('DELETE FROM undo_groups WHERE grp = ?', g); run('UPDATE undo_state SET active = 1'); db.exec('COMMIT'); };
const snap = () => JSON.stringify(['contacts','transactions','instruments','payroll_entries','attachments'].map(t => all(`SELECT * FROM ${t} ORDER BY id`)));
const eq = (a, b, m) => { if (a !== b) { console.error('FAIL', m); process.exitCode = 1; } else console.log('ok -', m); };

action(() => { run("INSERT INTO contacts VALUES ('c1','Magasin L''Attawfiq','SUPPLIER',NULL,NULL,'t')");
  run("INSERT INTO transactions VALUES ('t1','c1','PAYABLE','DEBT_ITEM','Engrais','TOMATO',100000,0,0,'UNPAID','2026-01-01',NULL,'t')");
  run("INSERT INTO instruments VALUES ('i1','t1',NULL,'c1','PAYABLE','CASH',30000,'2026-01-02','2026-01-02','DEBITED_PAID',NULL,0,'t')");
  run("INSERT INTO attachments VALUES ('a1','T','t1','x.jpg','t')"); });
const s1 = snap();
action(() => run("UPDATE transactions SET total_amount = 5, description = 'it''s changed' WHERE id = 't1'"));
undo(); eq(snap(), s1, 'undo update (with quotes in text)');
action(() => run("DELETE FROM contacts WHERE id = 'c1'"));
eq(all('SELECT * FROM transactions').length, 0, 'cascade delete removed children');
undo(); eq(snap(), s1, 'undo cascade delete restores parent + children + SET NULL links');
action(() => run("DELETE FROM transactions WHERE id = 't1'"));
eq(db.prepare("SELECT transaction_id FROM instruments").get().transaction_id, null, 'SET NULL applied');
undo(); eq(snap(), s1, 'undo delete restores SET NULL link');
undo(); eq(all('SELECT * FROM contacts').length + all('SELECT * FROM transactions').length, 0, 'undo first action removes everything');
db.exec('PRAGMA foreign_key_check');
