{
  "expo": {
    "name": "AgriCompte - الفلاح",
    "slug": "agricompte",
    "version": "1.0.0",
    "scheme": "agricompte",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "ma.agricompte.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#556B2F"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "extra": {
      "supportsRTL": true,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c419e0fb-2720-4919-9276-a6c2a04e271c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#556B2F"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ]
  }
}
